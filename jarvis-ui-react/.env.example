# Copy to .env.local and insert the value from secrets/core_api_token.txt.
# The Vite dev server reads this file in Node.js and injects the bearer token on /api/*.
# NEVER add the VITE_ prefix and NEVER commit .env.local.
JARVIS_API_TOKEN=replace_with_your_local_token

# Optional: where the FastAPI core listens during development.
# JARVIS_BACKEND_URL=http://localhost:8080
