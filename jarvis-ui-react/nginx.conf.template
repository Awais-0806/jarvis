# Jarvis React UI — non-root (10001), read-only rootfs, port 8080.
#
# This container is both the static host and the API proxy, so the bearer token is injected
# here and never reaches the browser. ${CORE_API_TOKEN} is substituted by docker-entrypoint.sh.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;
    server_tokens off;

    # Writable paths must live on the /tmp tmpfs because the rootfs is read-only.
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    client_max_body_size 10m;
    sendfile on;
    keepalive_timeout 30s;

    # Docker DNS: lets nginx start (and recover) even when core is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

        # Injected on every proxied request. The browser never sees this value.
        proxy_set_header Authorization "Bearer ${CORE_API_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;

        # Container liveness for the compose healthcheck.
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # --- Core routes that do NOT live under /api on the FastAPI app -------------------
        # POST /api/chat -> POST /chat
        location = /api/chat {
            set $core http://core:8000;
            proxy_pass $core/chat;
        }

        # GET /api/jobs/<id> -> GET /jobs/<id>
        location ^~ /api/jobs/ {
            set $core http://core:8000;
            rewrite ^/api/jobs/(.+)$ /jobs/$1 break;
            proxy_pass $core;
        }

        # POST /api/global-tenders/<id>/pitch -> POST /global-tenders/<id>/pitch
        location ~ ^/api/global-tenders/([^/]+)/pitch$ {
            set $core http://core:8000;
            proxy_pass $core/global-tenders/$1/pitch$is_args$args;
        }

        # Everything else already exists under /api on core:
        # /api/global-tenders, /api/voice/*, /api/host/*.
        location /api/ {
            set $core http://core:8000;
            proxy_pass $core;
        }

        # Hashed build assets can be cached forever.
        location /assets/ {
            expires 1y;
            try_files $uri =404;
        }

        # index.html itself is never cached, so a redeploy is picked up immediately.
        location = /index.html {
            expires -1;
        }

        # SPA fallback: client-side views have no files of their own.
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
